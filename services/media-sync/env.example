# Copy to .env and fill in per-node values. NOT committed.

# Container user mapping — match your existing grim (1000) / nat (1001) convention
PUID=1000
PGID=1000
TZ=Europe/Madrid

# Used as the Syncthing container hostname suffix, e.g. nat-server-syncthing
NODE_NAME=nat-server

# Web UI port for the cloud-storage file browser
FILEBROWSER_PORT=8082

# Syncplay server
SYNCPLAY_PORT=8999
# Recommended: set a password so only you two can join rooms on this server
SYNCPLAY_PASSWORD=
